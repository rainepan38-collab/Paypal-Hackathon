{
  "name": "splitmate-mobile-pwa",
  "version": "2.0.0",
  "private": true,
  "description": "Mobile-first group chat and AI bill splitting with PayPal Sandbox checkout",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
